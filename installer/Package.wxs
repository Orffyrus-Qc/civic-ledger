<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Civic Ledger"
    Manufacturer="Orffyrus"
    Version="1.3.0"
    UpgradeCode="76211ce3-9564-41c1-9fa7-8c56c5058e99"
    Scope="perUser"
    Compressed="yes">
    <SummaryInformation Description="Start and stop the Civic Ledger Docker stack." />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Civic Ledger" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Civic Ledger" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
      <Component Id="Shortcuts" Guid="93bc284b-978e-478f-bbd4-431cca16d0c7">
        <Shortcut
          Id="StartMenuShortcut"
          Name="Civic Ledger"
          Description="Start or stop the local watchdog"
          Target="[INSTALLFOLDER]CivicLedger.exe"
          WorkingDirectory="INSTALLFOLDER"
          Directory="AppMenuFolder" />
        <Shortcut
          Id="UninstallShortcut"
          Name="Uninstall Civic Ledger"
          Description="Remove Civic Ledger and optionally Docker, Ollama, and WSL 2"
          Target="[INSTALLFOLDER]CivicLedger.exe"
          Arguments="/uninstall"
          WorkingDirectory="INSTALLFOLDER"
          Directory="AppMenuFolder" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Orffyrus\CivicLedger"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Civic Ledger" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
